# Generated by github-codex-ready-work-dispatch setup.ps1. Rerun setup to update.
name: Codex Ready work dispatcher

on:
  push:
    branches: [__BASE_BRANCH__]
    paths:
      - '__WORK_ITEMS_PATH__/**'
      - '__WORKFLOW_PATH__'
__ADDITIONAL_PATHS__
  workflow_dispatch:
    inputs:
      retry_wi:
        description: 'Stopped WI-NNN to retry after recovery'
        required: false
        default: ''

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: __REPOSITORY_SLUG__-codex-ready-dispatch
  cancel-in-progress: false

jobs:
  dispatch:
    if: github.repository == '__REPOSITORY__' && github.ref == 'refs/heads/__BASE_BRANCH__'
    runs-on: [self-hosted, windows, __RUNNER_LABEL__]
    timeout-minutes: 300
    steps:
      - name: Dispatch Ready work
        shell: powershell
        env:
          BRIDGE_TOKEN: ${{ github.token }}
          BRIDGE_RETRY_WI: ${{ inputs.retry_wi }}
        run: |
          __EXPECTED_USER_CHECK__
          & '__INVOKE_PATH__' -Config '__CONFIG_PATH__' -RetryWi $env:BRIDGE_RETRY_WI
